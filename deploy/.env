# Ports for the LAN test stack — kept inside the reserved 10010-10020 range.
APP_PORT=10010
# Postgres is internal-only by default; DB_PORT is the host port used only when
# you publish it (kanban.sh --db-port, or a ports: entry in the compose file).
DB_PORT=10011

# Postgres credentials (used by both the db service and the app's -db URL).
PGUSER=kanban
PGPASSWORD=kanban
PGDATABASE=kanban
